{
  "name": "food-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "npx next dev web --webpack",
    "build:web": "npx next build web",
    "start:web": "npx next start web",
    "dev:scraper": "npx tsx src/index.ts",
    "dev:scraper:all": "npx tsx src/index.ts --all",
    "dev:scraper:billa": "npx tsx src/index.ts --retailer=billa",
    "dev:scraper:hofer": "npx tsx src/index.ts --retailer=hofer",
    "dev:scraper:lidl": "npx tsx src/index.ts --retailer=lidl",
    "dev:scraper:spar": "npx tsx src/index.ts --retailer=spar",
    "db:migrate": "npx tsx src/db/migrate.ts",
    "db:seed": "npx tsx src/db/seed.ts",
    "test": "npx tsx src/test/unit.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.1",
    "next": "^16.1.6",
    "pg": "^8.17.2",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "undici": "^7.19.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
